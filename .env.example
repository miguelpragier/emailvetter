# emailvetter configuration. Load locally with:
#   godotenv -f .env go run ./cmd/emailvetter

# Deployment environment: "production" enables strict startup checks.
APP_ENV=development

# HTTP listen address.
EMAILVETTER_ADDR=:8080

# rqlite HTTP endpoint (any node; writes are forwarded to the leader).
EMAILVETTER_RQLITE_ADDR=http://127.0.0.1:4001

# Optional HTTP Basic Auth for rqlite (leave empty when network-isolated).
EMAILVETTER_RQLITE_USER=
EMAILVETTER_RQLITE_PASS=

# Per-request timeout for rqlite calls.
EMAILVETTER_RQLITE_TIMEOUT=5s

# API keys, comma-separated. Write keys also grant read access. Leave both empty
# to run with authentication disabled (local development only).
EMAILVETTER_READ_KEYS=
EMAILVETTER_WRITE_KEYS=
